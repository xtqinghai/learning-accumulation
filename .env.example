# Copy this file to `.env` for local shell usage, or map the same keys in your deployment platform.
# This file is a template only. Do not commit real passwords, keys, or production endpoints.

# ------------------------------------------------------------------------------
# Profile
# ------------------------------------------------------------------------------
# dev: local development
# test: integration / test environment
# prod: production
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Database
# Required in test/prod
# ------------------------------------------------------------------------------
HBOOT_DB_URL=jdbc:mysql://localhost:13306/h_boot?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
HBOOT_DB_USERNAME=root
HBOOT_DB_PASSWORD=replace-me
ENGINE_DB_URL=jdbc:mysql://localhost:13306/h_boot?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
ENGINE_DB_USERNAME=root
ENGINE_DB_PASSWORD=replace-me

# ------------------------------------------------------------------------------
# Redis
# Required in test/prod
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=10000ms
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=5000ms

# ------------------------------------------------------------------------------
# File storage
# Required in prod when FILE_STORAGE=local
# ------------------------------------------------------------------------------
FILE_STORAGE=local
FILE_LOCAL_BASE_PATH=
FILE_PUBLIC_URL=http://localhost:8080/api/v1/file/preview
FILE_SECURITY_ENABLED=true
FILE_SECURITY_MAX_FILE_SIZE=104857600
FILE_SECURITY_ANTIVIRUS_ENABLED=false

# ------------------------------------------------------------------------------
# AI / Knowledge vector search
# Knowledge vector search needs PostgreSQL pgvector and an embedding model.
# Local Ollama: ollama pull bge-m3
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434
AI_API_KEY=ollama
AI_MODEL=qwen3.5:2b
AI_EMBEDDING_MODEL=bge-m3
KNOWLEDGE_EMBEDDING_ENABLED=true
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_CANDIDATE_LIMIT=24
KNOWLEDGE_EMBEDDING_BACKFILL_ENABLED=true

# ------------------------------------------------------------------------------
# API docs / Druid / Warm Flow UI
# dev defaults can be turned on, prod should remain off
# ------------------------------------------------------------------------------
APP_API_DOCS_ENABLED=true
APP_DRUID_MONITOR_ENABLED=true
APP_DRUID_MONITOR_USERNAME=
APP_DRUID_MONITOR_PASSWORD=
APP_DRUID_MONITOR_ALLOW=127.0.0.1
APP_DRUID_MONITOR_DENY=
WARM_FLOW_ENABLED=true
WARM_FLOW_UI_ENABLED=true
WARM_FLOW_BANNER=true

# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------
APP_AUTH_LOGIN_FAIL_PREFIX=login:fail:
APP_AUTH_MAX_RETRY_COUNT=5
APP_AUTH_RETRY_LOCK_MINUTES=10
APP_AUTH_SESSION_TIMEOUT_SECONDS=7200
APP_AUTH_SESSION_ACTIVE_TIMEOUT_SECONDS=7200
APP_AUTH_ALLOW_CONCURRENT_LOGIN=true
APP_AUTH_KICKOUT_OLD_SESSION=true

# ------------------------------------------------------------------------------
# Production checklist
# Required when SPRING_PROFILES_ACTIVE=prod:
# - HBOOT_DB_URL / HBOOT_DB_USERNAME / HBOOT_DB_PASSWORD
# - ENGINE_DB_URL / ENGINE_DB_USERNAME / ENGINE_DB_PASSWORD
# - REDIS_HOST
# - FILE_LOCAL_BASE_PATH
# - FILE_PUBLIC_URL
# Recommended in prod:
# - APP_API_DOCS_ENABLED=false
# - APP_DRUID_MONITOR_ENABLED=false
# - WARM_FLOW_UI_ENABLED=false
# - WARM_FLOW_BANNER=false
# ------------------------------------------------------------------------------
