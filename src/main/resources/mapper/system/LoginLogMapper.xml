<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quinn.hboot.system.mapper.LoginLogMapper">

    <!-- 获取系统登录日志分页列表 -->
    <select id="getLoginLogPage" resultType="com.quinn.hboot.system.model.vo.LoginLogVO">
        SELECT
                username,
                ip,
                location,
                browser,
                os,
                status,
                msg,
                login_time
        FROM
            sys_login_log
        <where>
            <if test="queryParams.username != null and queryParams.username != ''">
                AND username LIKE CONCAT('%', #{queryParams.username}, '%')
            </if>
        </where>
    </select>

</mapper>
