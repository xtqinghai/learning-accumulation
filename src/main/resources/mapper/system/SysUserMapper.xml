<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quinn.hboot.system.mapper.SysUserMapper">
    <select id="selectUserPage" resultType="com.quinn.hboot.system.model.entity.SysUser">
        select u.*, d.name as deptName, r.name as roleName, p.post_name as postName
        from sys_user u
        left join sys_dept d on u.dept_id = d.id
        left join sys_role r on u.role_id = r.id
        left join sys_post p on u.post_id = p.id
        <where>
            <if test="queryParams.username != null and queryParams.username != ''">
                and u.username like concat('%',#{queryParams.username},'%')
            </if>
            <if test="queryParams.nickname != null and queryParams.nickname != ''">
                and u.nickname like concat('%',#{queryParams.nickname},'%')
            </if>
            <if test="queryParams.deptId != null and queryParams.deptId != ''">
                and u.dept_id = #{queryParams.deptId}
            </if>
            <if test="queryParams.roleId != null and queryParams.roleId != ''">
                and u.role_id = #{queryParams.roleId}
            </if>
            <if test="queryParams.postId != null and queryParams.postId != ''">
                and u.post_id = #{queryParams.postId}
            </if>
            <if test="queryParams.status != null and queryParams.status != ''">
                and u.status = #{queryParams.status}
            </if>
        </where>
    </select>
    <select id="selectUsersByRoleIds" resultType="com.quinn.hboot.system.model.entity.SysUser" parameterType="java.util.List">
        select *
        from sys_user u
        where u.id in (
        select r.user_id
        from sys_user_role r
        where r.role_id in
        <!-- 使用foreach遍历List集合 -->
        <foreach collection="list" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        )
    </select>
    <select id="selectUsersByDeptIds" resultType="com.quinn.hboot.system.model.entity.SysUser" parameterType="java.util.List">
        select *
        from sys_user u
        where u.dept_id in
        <!-- 使用foreach遍历List集合 -->
        <foreach collection="list" item="deptId" open="(" separator="," close=")">
            #{deptId}
        </foreach>
        )
    </select>
    <select id="selectUsersByPostIds" resultType="com.quinn.hboot.system.model.entity.SysUser" parameterType="java.util.List">
        select *
        from sys_user u
        where u.id in (
        select r.user_id
        from sys_user_post r
        where r.id in
        <!-- 使用foreach遍历List集合 -->
        <foreach collection="list" item="postId" open="(" separator="," close=")">
            #{postId}
        </foreach>
        )
    </select>
</mapper>
