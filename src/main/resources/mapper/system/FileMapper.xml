<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quinn.hboot.system.mapper.FileMapper">

    <!-- 获取文件管理分页列表 -->
    <select id="getFilePage" resultType="com.quinn.hboot.system.model.vo.FileVO">
        SELECT
                id,
                file_name,
                file_ext,
                content_type,
                file_size,
                file_hash,
                storage_type,
                storage_path,
                url,
                status,
                create_time,
                update_time
        FROM
            sys_file
        <where>
            status = 1
            <if test="queryParams.fileName != null and queryParams.fileName != ''">
                AND file_name LIKE CONCAT('%', #{queryParams.fileName}, '%')
            </if>
        </where>
    </select>

</mapper>
